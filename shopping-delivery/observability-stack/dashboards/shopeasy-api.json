    {
      "type": "table",
      "title": "Rotas no período (requisições, erros, latência)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Totais do intervalo selecionado. Ordene clicando no cabeçalho.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (http_request_method, http_route) (increase(http_server_request_duration_seconds_count{service_name=\"backend-spring\", http_route=~\"$route\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "sum by (http_request_method, http_route) (increase(http_server_request_duration_seconds_count{service_name=\"backend-spring\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "sum by (http_request_method, http_route) (increase(http_server_request_duration_seconds_count{service_name=\"backend-spring\", http_route=~\"$route\", http_response_status_code=~\"4..\"}[$__range]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "D",
          "expr": "histogram_quantile(0.95, sum by (le, http_request_method, http_route) (rate(http_server_request_duration_seconds_bucket{service_name=\"backend-spring\", http_route=~\"$route\"}[$__range])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "http_route",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "http_request_method 2": true,
              "http_request_method 3": true,
              "http_request_method 4": true
            },
            "renameByName": {
              "http_request_method 1": "Método",
              "http_route": "Rota",
              "Value #A": "Requisições",
              "Value #B": "Erros 5xx",
              "Value #C": "Respostas 4xx",
              "Value #D": "p95"
            },
            "indexByName": {
              "http_request_method 1": 0,
              "http_route": 1,
              "Value #A": 2,
              "Value #C": 3,
              "Value #B": 4,
              "Value #D": 5
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Erros 5xx"
            },
