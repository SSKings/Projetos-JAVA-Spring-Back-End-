    {
      "type": "timeseries",
      "title": "Recusas: 401, 403, 413, 429 por rota",
      "description": "401 = sem login, token inválido/revogado ou assinatura do webhook inválida · 403 = sem permissão (ou IP fora da allowlist do webhook) · 413 = corpo > 64 KB · 429 = rate limit ou conta bloqueada. Senha errada no login é 400 (painel ao lado). Picos aqui sugerem força bruta, varredura ou abuso (ver security-review.md).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (http_response_status_code, http_route) (rate(http_server_request_duration_seconds_count{service_name=\"backend-spring\", http_route=~\"$route\", http_response_status_code=~\"401|403|413|429\"}[$__rate_interval]))",
