    "list": [
      {
        "name": "route",
        "label": "Rota",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_request_duration_seconds_count{service_name=\"backend-spring\"}, http_route)",
          "refId": "route"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=\"backend-spring\"}, http_route)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
