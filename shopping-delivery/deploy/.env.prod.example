# Copie para .env.prod (NUNCA versione o .env.prod) e preencha. A API se recusa a subir com valores
# ausentes, fracos ou de desenvolvimento (ProductionConfigValidator).

# ---- Banco ----
DATABASE_NAME=shopeasy
DATABASE_USERNAME=shopeasy
# openssl rand -base64 24
DATABASE_PASSWORD=

# ---- Segredos da aplicação ----
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (cifra os segredos de MFA)
APP_ENCRYPTION_KEY=
JWT_EXPIRATION_MINUTES=120

# ---- Front-end: origem exata, https ----
CORS_ALLOWED_ORIGINS=https://loja.seudominio.com.br

# ---- Administrador inicial (precisa ativar o MFA no primeiro acesso) ----
ADMIN_NAME=Administrador
ADMIN_EMAIL=
# 12+ caracteres, letras e números
ADMIN_PASSWORD=
REQUIRE_ADMIN_MFA=true

# ---- Pix ----
# chave da conta PJ (de preferência o CNPJ, só dígitos)
PIX_KEY=
# igual ao titular da conta (até 25 caracteres) e cidade (até 15)
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=
PIX_EXPIRATION_MINUTES=30
# openssl rand -base64 48 — vazio desativa o webhook (só confirmação manual)
PIX_WEBHOOK_SECRET=
# IPs/CIDRs do PSP, separados por vírgula. OBRIGATÓRIO quando PIX_WEBHOOK_SECRET está preenchido.
PIX_WEBHOOK_ALLOWED_IPS=

# ---- Bot de administração no Telegram (opcional, ADR-024) ----
# Um bot só para isto (não o dos alertas). Gere a configuração com scripts/telegram-admin-bot-setup.sh e copie as
# três linhas. ADMINS = chatId:email-de-um-ADMIN-com-MFA, separados por vírgula. A API só faz saída para
# api.telegram.org (long polling): nada muda no nginx.
TELEGRAM_ADMIN_BOT_ENABLED=false
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_BOT_ADMINS=

# ---- Anti-abuso ----
# Contas novas por origem (IP ou bloco /64 IPv6) em 24 h. Atrás de CGNAT/empresa, muitos clientes dividem o IP:
# aumente se aparecer "Too many accounts created from this network" para clientes legítimos.
REGISTRATIONS_PER_DAY=10
# Hosts permitidos para imagens de produto (vírgula). Ao mudar, atualize o img-src em security-headers.inc.
PRODUCT_IMAGE_HOSTS=images.unsplash.com

# ---- Recursos ----
# memória máxima do container da API (o heap Java fica em ~75% disto)
API_MEM_LIMIT=1536m
# conexões do pool com o PostgreSQL (no teste de carga, 10 bastaram: o banco não foi gargalo)
DATABASE_POOL_SIZE=10
DB_MEM_LIMIT=1g
WEB_MEM_LIMIT=256m

# ---- Backup do banco (deploy/backup-db.sh, agendado no cron do servidor) ----
# Senha que cifra os dumps (AES-256). Guarde-a FORA do servidor (cofre de senhas): sem ela o backup não abre.
# openssl rand -base64 32
BACKUP_PASSPHRASE=
# Pasta dos dumps no servidor; copie-a para fora (outro provedor/região) — backup no mesmo disco não é backup.
BACKUP_DIR=/var/backups/shopeasy
BACKUP_KEEP_DAYS=14

# ---- Termos (mude ao publicar nova versão dos termos/política) ----
TERMS_VERSION=2026-11-05

# ---- Identificação da empresa (rodapé e páginas legais) ----
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_TRADE_NAME=ShopEasy
VITE_COMPANY_CNPJ=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_EMAIL=
VITE_COMPANY_PHONE=
VITE_COMPANY_DPO_EMAIL=
