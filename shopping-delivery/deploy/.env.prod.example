# Copie para .env.prod (NUNCA versione o .env.prod) e preencha. A API se recusa a subir com valores
# ausentes, fracos ou de desenvolvimento (ProductionConfigValidator).

# ---- Banco ----
DATABASE_NAME=shopeasy
DATABASE_USERNAME=shopeasy
# openssl rand -base64 24
DATABASE_PASSWORD=

# ---- Segredos da aplicação ----
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (cifra os segredos de MFA)
APP_ENCRYPTION_KEY=
JWT_EXPIRATION_MINUTES=120

# ---- Front-end: origem exata, https ----
CORS_ALLOWED_ORIGINS=https://loja.seudominio.com.br

# ---- Administrador inicial (precisa ativar o MFA no primeiro acesso) ----
ADMIN_NAME=Administrador
ADMIN_EMAIL=
# 12+ caracteres, letras e números
ADMIN_PASSWORD=
REQUIRE_ADMIN_MFA=true

# ---- Pix ----
# chave da conta PJ (de preferência o CNPJ, só dígitos)
PIX_KEY=
# igual ao titular da conta (até 25 caracteres) e cidade (até 15)
PIX_MERCHANT_NAME=
PIX_MERCHANT_CITY=
PIX_EXPIRATION_MINUTES=30
# openssl rand -base64 48 — vazio desativa o webhook (só confirmação manual)
PIX_WEBHOOK_SECRET=
# IPs/CIDRs do PSP, separados por vírgula
PIX_WEBHOOK_ALLOWED_IPS=

# ---- Termos (mude ao publicar nova versão dos termos/política) ----
TERMS_VERSION=2026-11-05

# ---- Identificação da empresa (rodapé e páginas legais) ----
VITE_COMPANY_LEGAL_NAME=
VITE_COMPANY_TRADE_NAME=ShopEasy
VITE_COMPANY_CNPJ=
VITE_COMPANY_ADDRESS=
VITE_COMPANY_EMAIL=
VITE_COMPANY_PHONE=
VITE_COMPANY_DPO_EMAIL=
