# ---- URL da API ----
# "/" = mesma origem: produção atrás do nginx (deploy/nginx.conf faz proxy de /api). Recomendado.
# Vazio = dev: chama http://<host pelo qual a página foi aberta>:8080.
# Outro domínio: VITE_API_BASE_URL=https://api.seudominio.com.br
# VITE_API_BASE_URL=/

# ---- Identificação do fornecedor (Decreto 7.962/2013) e canal LGPD ----
# Enquanto vazias, rodapé e páginas legais mostram [preencher] e um aviso de modelo.
# VITE_COMPANY_LEGAL_NAME=Loja Exemplo Comércio Ltda
# VITE_COMPANY_TRADE_NAME=ShopEasy
# VITE_COMPANY_CNPJ=00.000.000/0001-00
# VITE_COMPANY_ADDRESS=Rua Exemplo, 100 - Centro - São Paulo/SP - 01000-000
# VITE_COMPANY_EMAIL=atendimento@seudominio.com.br
# VITE_COMPANY_PHONE=(11) 0000-0000
# VITE_COMPANY_DPO_EMAIL=privacidade@seudominio.com.br
# Deve ser igual a TERMS_VERSION do back-end
# VITE_TERMS_VERSION=2026-11-05
