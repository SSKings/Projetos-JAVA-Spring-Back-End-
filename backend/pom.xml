<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>
	<groupId>com.sskings</groupId>
	<artifactId>ecommerce</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ecommerce</name>
	<description>Simple e-commerce REST API</description>
	<properties>
		<java.version>17</java.version>
		<!-- vazio por padrão: o JaCoCo preenche no verify; sem isso, quem roda sem ele (PIT) recebe "@{argLine}" literal -->
		<argLine></argLine>
		<springdoc.version>3.2.0</springdoc.version>
		<!-- agente Java do OpenTelemetry usado por run-backend.sh (não entra no jar da aplicação) -->
		<otel-javaagent.version>2.33.0</otel-javaagent.version>
		<!--
			Versões acima das que o Spring Boot gerencia, para corrigir CVEs (docs/security-review.md, revisão 2).
			O Dependabot só atualiza o parent; o CI roda scripts/check-dependency-cves.py para pegar o resto.
			Remova cada linha quando o Spring Boot passar a trazer uma versão igual ou maior.
			Jackson 2: só o swagger-core (springdoc) ainda usa; o app usa o Jackson 3.
		-->
		<jackson-2-bom.version>2.21.8</jackson-2-bom.version>  <!-- 2.21.4: CVE-2026-89407 (ReDoS), -91777 (DoS) e outras -->
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- E-mail transacional por SMTP (ADR-025): Mailpit em dev, Gmail com senha de app em produção -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- Observabilidade: health/metrics/prometheus (ADR-022). Traces e logs vêm do agente OpenTelemetry (run-backend.sh) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Boot 4: métricas são um módulo à parte (o /actuator/prometheus depende dele) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-micrometer-metrics</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!-- Cliente HTTP do bot do Telegram (RestClient) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-restclient</artifactId>
		</dependency>
		<dependency>
			<groupId>com.auth0</groupId>
			<artifactId>java-jwt</artifactId>
			<version>4.6.2</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<!-- Banco de produção (perfil prod). O H2 fica só para dev/testes. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- Boot 4: o console do H2 (só em dev, restrito à própria máquina) é um módulo à parte -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-h2console</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>
		<!-- Boot 4: um starter de teste por tecnologia (cada um traz o spring-boot-starter-test) -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- @AutoConfigureMetrics: liga os exportadores (o /actuator/prometheus) nos testes de segurança do Actuator -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-micrometer-metrics-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
			<plugin>
				<!-- Testes sempre com a JVM em UTC, como no CI e no servidor: no fuso de São Paulo, um teste que confunde o
				     "hoje" do sistema com o do app passa na máquina e só quebra no CI (lição do Bolso, 2026-11-19). -->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<argLine>@{argLine} -Duser.timezone=UTC</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.16</version>
				<configuration>
					<excludes>
						<!-- Classe de bootstrap não entra na métrica -->
						<exclude>com/sskings/ecommerce/EcommerceApplication.class</exclude>
					</excludes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals><goal>prepare-agent</goal></goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals><goal>report</goal></goals>
					</execution>
					<execution>
						<!-- mvn verify falha se a cobertura cair abaixo do mínimo -->
						<id>check</id>
						<goals><goal>check</goal></goals>
						<configuration>
							<rules>
								<rule>
									<element>BUNDLE</element>
									<limits>
										<limit>
											<counter>LINE</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.97</minimum>
										</limit>
										<limit>
											<counter>BRANCH</counter>
											<value>COVEREDRATIO</value>
											<minimum>0.93</minimum>
										</limit>
									</limits>
								</rule>
							</rules>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<!-- Teste de mutação (PIT) das regras de segurança e de dinheiro: ./mvnw test-compile pitest:mutationCoverage.
				     Injeta defeitos (troca < por <=, apaga condições, inverte retornos) e exige que os testes peguem a maioria.
				     Fora do verify (é mais lento); o CI roda em todo PR. -->
				<groupId>org.pitest</groupId>
				<artifactId>pitest-maven</artifactId>
				<version>1.30.2</version>
				<dependencies>
					<dependency>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-junit5-plugin</artifactId>
						<version>1.2.3</version>
					</dependency>
				</dependencies>
				<configuration>
					<targetClasses>
						<param>com.sskings.ecommerce.payment.PixBrCode*</param>
						<param>com.sskings.ecommerce.security.TotpService*</param>
						<param>com.sskings.ecommerce.security.PasswordStrength*</param>
						<param>com.sskings.ecommerce.security.RateLimitFilter*</param>
						<param>com.sskings.ecommerce.config.ProductionConfigValidator*</param>
						<param>com.sskings.ecommerce.service.LoginAttemptService*</param>
					</targetClasses>
					<targetTests>
						<param>com.sskings.ecommerce.**.PixBrCodeTest</param>
						<param>com.sskings.ecommerce.**.TotpServiceTest</param>
						<param>com.sskings.ecommerce.**.PasswordStrengthTest</param>
						<param>com.sskings.ecommerce.**.RateLimitFilterTest</param>
						<param>com.sskings.ecommerce.**.ProductionConfigValidatorTest</param>
						<param>com.sskings.ecommerce.**.LoginAttemptServiceTest</param>
					</targetTests>
					<mutators><mutator>STRONGER</mutator></mutators>
					<outputFormats><param>HTML</param><param>XML</param></outputFormats>
					<timestampedReports>false</timestampedReports>
					<threads>4</threads>
					<mutationThreshold>90</mutationThreshold>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
